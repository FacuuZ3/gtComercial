# ============================================================================
# Variables de entorno - Backend NestJS
# ----------------------------------------------------------------------------
# Copiar este archivo como `.env` en el mismo directorio y ajustar los valores
# de cada variable según el entorno (desarrollo / producción).
#
# Las variables se validan con Joi en el módulo ConfigModule, siguiendo la
# práctica recomendada por The Twelve-Factor App.
# ============================================================================

# --- Aplicación ---
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgresql://padel:padel@localhost:5432/padel_turnos?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=cambiar_por_secreto_seguro_de_64_caracteres_minimo
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar_por_otro_secreto_distinto_de_64_caracteres
JWT_REFRESH_EXPIRES_IN=7d

# --- Email (Nodemailer / SMTP) ---
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=usuario_smtp
MAIL_PASSWORD=contrasena_smtp
MAIL_FROM="Pádel Turnos <no-reply@padelturnos.local>"

# --- Throttler / Rate Limit ---
THROTTLE_TTL=60
THROTTLE_LIMIT=10
