# ============================================================================
# Variables de entorno - Frontend Next.js
# ----------------------------------------------------------------------------
# Las variables prefijadas con NEXT_PUBLIC_ son visibles desde el navegador.
# Copiar a `.env.local` y ajustar.
# ============================================================================

# URL pública del backend NestJS
NEXT_PUBLIC_API_URL=http://localhost:3001

# Tenant (complejo) por defecto para desarrollo local, donde no hay subdominio.
# En producción el tenant se resuelve del subdominio (clubA.miapp.com).
# Debe coincidir con un slug existente (ver seed: "norte" o "sur").
NEXT_PUBLIC_DEFAULT_TENANT=norte
