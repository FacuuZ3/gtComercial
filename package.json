{
  "name": "padel-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma SaaS de gestión y reserva de turnos para complejos deportivos.",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev --workspace=apps/api",
    "api:build": "npm run build --workspace=apps/api",
    "web:dev": "npm run dev --workspace=apps/web",
    "web:build": "npm run build --workspace=apps/web",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "npm run prisma:migrate --workspace=apps/api",
    "db:seed": "npm run seed --workspace=apps/api"
  }
}
